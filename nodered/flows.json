        "z": "a0f9b39a9e0bd673",
        "name": "",
        "field": "payload",
        "fieldType": "msg",
        "format": "handlebars",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <title>ZIP Code Searcher</title>\n    <style>\n        body { font-family: Arial, sans-serif; padding: 20px; }\n        input { padding: 8px; margin-right: 8px; width: 200px; }\n        button { padding: 8px 16px; }\n        #result { margin-top: 20px; }\n        .field { padding: 6px 0; }\n        .label { font-weight: bold; }\n    </style>\n</head>\n<body>\n    <h1>ZIP Code Searcher</h1>\n    <input type=\"text\" id=\"cep\" placeholder=\"Ex: 01310100\" maxlength=\"8\" />\n    <button onclick=\"search()\">Search</button>\n\n    <div id=\"result\"></div>\n\n    <script>\n        async function search() {\n            const cep = document.getElementById('cep').value.replace(/\\D/g, '');\n            const res = await fetch(`/cep/${cep}`);\n            const data = await res.json();\n\n            if (data.error) {\n                document.getElementById('result').innerHTML = '<p>ZIP code not found.</p>';\n                return;\n            }\n\n            document.getElementById('result').innerHTML = `\n                <div class=\"field\"><span class=\"label\">Street:</span> ${data.street}</div>\n                <div class=\"field\"><span class=\"label\">Neighborhood:</span> ${data.neighborhood}</div>\n                <div class=\"field\"><span class=\"label\">City:</span> ${data.city}</div>\n                <div class=\"field\"><span class=\"label\">State:</span> ${data.state}</div>\n            `;\n        }\n    </script>\n</body>\n</html>",
        "output": "str",
        "x": 260,
        "y": 480,
